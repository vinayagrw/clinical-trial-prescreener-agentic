# =====================================================================
# CTP Trial Pre-Screener — React sample UI environment variables
#
# Copy this file to .env.local (same directory) and fill in the keys
# you want to use. You do NOT need all of them. The orchestrator tries
# providers left → right as listed in VITE_LLM_PROVIDER_ORDER.
#
# The default chain is:
# Actual provider order below includes Anthropic before demo.
#   Ollama (local) → Gemini (free tier) → Groq (free tier) → demo
#
# No key at all? Leave everything blank and keep
# VITE_START_IN_DEMO_MODE=true. The app runs on fixture responses.
# =====================================================================

# --- Provider failover chain (comma-separated, evaluated left → right) ---
VITE_LLM_PROVIDER_ORDER=ollama,openai,gemini,groq,anthropic,demo

# --- Ollama (LOCAL, free, offline) ---
# Setup:
#   1. Install Ollama from https://ollama.com
#   2. Pull the models: `ollama pull llama3.2:3b` and `ollama pull nomic-embed-text`
#   3. Start the daemon: `ollama serve` (or it auto-starts on install)
#   4. The Vite dev server proxies /api/ollama → http://localhost:11434
# No API key required.
VITE_OLLAMA_CHAT_MODEL=llama3.2:3b
VITE_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- OpenAI (paid, chat + embeddings) ---
# Add a standard API key from the OpenAI dashboard.
VITE_OPENAI_API_KEY=
VITE_OPENAI_CHAT_MODEL=gpt-4.1-mini
VITE_OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Google Gemini (free tier, 15 RPM on gemini-2.0-flash, 1M tokens/day) ---
# Get a free key: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_CHAT_MODEL=gemini-2.0-flash
VITE_GEMINI_EMBED_MODEL=text-embedding-004

# --- Anthropic Claude (paid, fast, high-quality) ---
# Get a key: https://console.anthropic.com/settings/keys
# Claude does NOT support embeddings — used for chat only.
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5-20250929

# --- Groq (free tier, 30 RPM on llama-3.3-70b) ---
# Get a free key: https://console.groq.com/keys
# Groq does NOT support embeddings — used for chat only.
VITE_GROQ_API_KEY=
VITE_GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Concurrency caps (used by F3 criterion evaluation) ---
VITE_CONCURRENCY_OLLAMA=2
VITE_CONCURRENCY_GEMINI=3
VITE_CONCURRENCY_GROQ=3

# --- Start the app in demo mode (fixture responses, no live calls) ---
# Toggle live calls from the UI header after reviewing the safety notice.
VITE_START_IN_DEMO_MODE=true

# --- Clinical handoff API ---
VITE_CLINICAL_API_BASE=/api
CLINICAL_HANDOFF_PORT=4180

# --- Research digest workspace (server / worker) ---
# Required for the live literature-monitoring workspace.
RESEARCH_DATABASE_URL=
RESEARCH_VECTOR_DIMENSIONS=64
RESEARCH_NCBI_EMAIL=
RESEARCH_NCBI_API_KEY=
RESEARCH_INGEST_LOOKBACK_DAYS=7
RESEARCH_PUBMED_RETMAX=80
RESEARCH_PREPRINT_PAGE_SIZE=75
RESEARCH_SCHEDULER_ENABLED=true
RESEARCH_POLL_INTERVAL_MS=3600000
RESEARCH_DIGEST_CHECK_INTERVAL_MS=900000

# Optional server-side Gemini enrichment for digest summaries.
RESEARCH_GEMINI_API_KEY=
RESEARCH_GEMINI_MODEL=gemini-2.0-flash
